# Set server secrets with Sites environment variables for production.
# Local Worker preview uses an ignored .dev.vars file instead.
OPENAI_API_KEY=
OPENAI_MODEL=
# Comma-separated Site-scoped ChatGPT user IDs. Local mock user: local_seedy.
ADMIN_USER_IDS=
# Optional exact email allowlist checked against dispatch-authenticated identity.
ADMIN_EMAILS=
